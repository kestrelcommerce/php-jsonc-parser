{
    "name": "kestrelwp/php-jsonc-parser",
    "description": "Scanner and parser for JSON with comments (JSONC) - PHP port of Microsoft's node-jsonc-parser",
    "type": "library",
    "license": "MIT",
    "keywords": ["json", "jsonc", "parser", "scanner", "comments", "json-with-comments"],
    "authors": [
        {
            "name": "Kestrel WP",
            "homepage": "https://github.com/kestrelwp"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kestrel\\JsoncParser\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "stan": "phpstan analyse",
        "format": "pint",
        "format-check": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
